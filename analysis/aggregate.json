 "tasks": {
  "catalog": {
   "name": "Catalog record identifiers",
   "domain": "API design / identifier strategy",
   "approach_a": "Sequential integer identifiers (auto-increment counter, rendered as decimal strings)",
   "approach_b": "Random UUID identifiers (uuid4 strings)"
  },
  "eventbus": {
   "name": "In-process event bus",
   "domain": "event architecture",
   "approach_a": "Synchronous dispatch: handlers run immediately inside publish()",
   "approach_b": "Queued dispatch: publish() enqueues; handlers run in FIFO order during flush()"
  },
  "expr": {
   "name": "Arithmetic expression evaluator",
   "domain": "parsing strategy",
   "approach_a": "Recursive descent: one recursive function per grammar level (or precedence climbing)",
   "approach_b": "Shunting-yard: table-driven operator precedence with explicit operator/output stacks (RPN)"
  },
  "graph": {
   "name": "Undirected graph library",
   "domain": "data representation",
   "approach_a": "Adjacency lists/sets: mapping from node to the set of its neighbours",
   "approach_b": "Adjacency matrix: an n x n boolean matrix indexed by node index"
  },
  "kvstore": {
   "name": "Key-value store persistence",
   "domain": "storage representation",
   "approach_a": "JSON document file (whole store loaded/saved as one JSON file)",
   "approach_b": "SQLite database file (sqlite3 module)"
  },
  "ledger": {
   "name": "Account ledger state management",
   "domain": "state management",
   "approach_a": "Event-sourced (append-only log of operations; balances derived from the log)",
   "approach_b": "Snapshot state (current balances stored and mutated directly; no operation log)"
  },
  "ratelimit": {
   "name": "Per-key rate limiter",
   "domain": "algorithm / data structure",
   "approach_a": "Token bucket: per-key token count + last refill time; continuous refill",
   "approach_b": "Sliding window log: per-key list of request timestamps within the window"
  },
  "renderers": {
   "name": "Report renderers",
   "domain": "composition vs inheritance",
   "approach_a": "Inheritance: abstract Renderer base class with a subclass per format (template method)",
   "approach_b": "Composition: plain renderer functions/strategies registered in a registry, shared helpers composed"
  },
  "undo": {
   "name": "Text buffer undo/redo",
   "domain": "undo architecture",
   "approach_a": "Command pattern: each edit is a command object with execute/undo (inverse operation)",
   "approach_b": "Memento: snapshot the full buffer text before each edit; undo restores the snapshot"
  },
  "wire": {
   "name": "Sensor record wire format",
   "domain": "serialization format",
   "approach_a": "Compact fixed-width binary records (struct-packed) with a small header",
   "approach_b": "Newline-delimited JSON text (one JSON object per line)"
  }
 },
